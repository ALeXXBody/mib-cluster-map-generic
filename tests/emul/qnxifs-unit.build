[linker="(40;1;)qcc -bootstrap -nostdlib -Wl,--no-keep-memory -Vgcc_ntoarmv7%(m!=3,%(m!=6,%(e==0, -EL%)%(e==1, -EB%)%)%)%(h!=0, -Wl,-Ttext -Wl,0x%t%)%(d!=0, -Wl,-Tdata -Wl,0x%d%) -o%o %i %[M -L%^i -Wl,-uinit_%n -lmod_%n%] /w/libstartup.a -L/opt/qnx650/target/qnx6/armle-v7/lib -L/opt/qnx650/target/qnx6/armle-v7/usr/lib -llzo -lucl -ldrvr"]
[linker="(40;2;)cp %i %o"]
[image=0x40200000]
# add the mkifs "option" directive nothing to check
[virtual=armle-v7,raw] .bootstrap = {
    /w/startup-virt -v -S
    PATH=:/proc/boot:/eso/bin/apps LD_LIBRARY_PATH=:/proc/boot:/proc/boot/lib:/lib:/eso/lib procnto-smp -vvv
}
[+script] .script = {
    procmgr_symlink ../../proc/boot/libc.so.3 /usr/lib/ldqnx.so.2
    devc-serdebug -e -F -S
    waitfor /dev/ser1 4
    reopen /dev/ser1
    display_msg "@@QNXRUN-START@@"
    /proc/boot/dmdtgo
    display_msg "@@QNXRUN-END@@"
}
[type=link] /usr/lib/ldqnx.so.2=/proc/boot/libc.so.3

[perms=+r,+x]
libc.so.3
libm.so.2
libsocket.so.3
/w/procnto-smp
devc-serdebug=/w/devc-serdebug

[perms=+r,+x]
eso/bin/apps/dmdt=/w/eso/bin/apps/dmdt
lib/libdmdt_core.so=/w/lib/libdmdt_core.so
lib/libcomm.so=/w/lib/libcomm.so
lib/libosal.so=/w/lib/libosal.so
lib/libutil.so=/w/lib/libutil.so
lib/libiplcommon.so=/w/lib/libiplcommon.so
lib/libeal.so=/w/lib/libeal.so
lib/libecpp-ne.so.4=/w/lib/libecpp-ne.so.4
dmdtgo=/w/dmdtgo
eso/bin/apps/dmdt_args=/w/dmdt_args_from_host

config/framework.json=/w/config/framework.json
